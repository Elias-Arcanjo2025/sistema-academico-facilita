APP_NAME=Facilita
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://facilita2.test

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=facilita2
DB_USERNAME=root
DB_PASSWORD=

# Local Laragon (sem Redis): file. Produção multi-nó: redis ou database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

# Produção: APP_DEBUG=false, SESSION_SECURE_COOKIE=true, HTTPS activo
# ASSISTENTE_ENABLED=false desactiva o chat IA
ASSISTENTE_ENABLED=true
ASSISTENTE_MODEL=gemini-2.5-flash-lite
ASSISTENTE_MAX_TOKENS=2048
ASSISTENTE_RATE_LIMIT=40

AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Passwords iniciais do seeder (opcional). Sem isto, gera password aleatória e regista no log.
# FACILITA_SEED_ADMIN_PASSWORD=
# FACILITA_SEED_GESTOR_PASSWORD=

# Perfis de ensino desta instalação
# Prioridade: Configurações (UI) > este valor no .env > ii_ciclo
# primario = 1ª–6ª | i_ciclo = 7ª–9ª | ii_ciclo = 10ª–13ª
# Exemplos: ii_ciclo | i_ciclo,ii_ciclo | primario,i_ciclo,ii_ciclo
ENSINO_PERFIS=ii_ciclo

# Registo público (também configurável em Admin → Página pública → Opções)
# REGISTO_PUBLICO_ACTIVO=1

MAIL_MAILER=log

# Prefixo das rotas autenticadas (ex.: app → /app/dashboard). Vazio = raiz.
FACILITA_ROUTE_PREFIX=app
# Validade de links assinados para boletins (horas)
FACILITA_SIGNED_DOCUMENT_TTL=24

# Controlo Facilita (licenciamento multi-instalação)
# off = desactivado | school = instalação de escola | hub = painel central
CONTROL_MODE=off
CONTROL_HUB_URL=
CONTROL_INSTALLATION_ID=
CONTROL_SECRET=
# Minutos entre syncs com o hub (1–59). Ex.: 15, 30, 45
CONTROL_SYNC_INTERVAL=30
# Em navegação web: minutos entre consultas leves de licença ao hub (bloqueio rápido)
CONTROL_LICENSE_CHECK_MINUTES=1
# Horas sem contacto com o hub antes de bloquear a escola
CONTROL_GRACE_HOURS=72
CONTROL_BYPASS=false
CONTROL_PRECO_ANUAL_ALUNO=0

# WhatsApp (Meta Cloud API) — provider=log grava só na BD
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BOT_ENABLED=true
WHATSAPP_TPL_MAC=
WHATSAPP_TPL_PROVA=
WHATSAPP_TPL_BOLETIM=
WHATSAPP_TPL_COBRANCA=
WHATSAPP_TPL_RESUMO_SEMANAL=
WHATSAPP_TPL_FALTA=
WHATSAPP_TPL_OCORRENCIA=
